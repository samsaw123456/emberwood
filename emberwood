#!/bin/sh
# Emberwood — launch the current game from this project.
# In Zed: open this project, then choose the "Play Emberwood" task.
# Also available offline in the Applications menu with its fox-and-forest icon.
# Install that shortcut with: python3 tools/install_app.py
# Shareable Linux installer: GitHub Releases (includes the offline game engine).
# Current adventure: 20 levels, 6 bosses, 5 weapons, and 8 armor sets.
# Frog, opossum, boar, wolf, eagle, and owl — a boss every third level.
# Boss tip: dodge the leap, then attack the gold cap.
# New discoveries: dash-open treasure chests, leaf shields, and a gem-fetching firefly friend.
# Clearer monster art: glossy jelly, six beetle legs, and broad flapping bat wings.
# Regular monsters: opossums, hopping moss slimes, bramble beetles, and cave bats.
# New rewards: Thorn fan in Willow Narrows; Sunwood lance in Rootbound Ruins.
# New trails cross riverlands, frostpine mountains, and the ancient forest.
# Playtest results and screenshots: docs/DISCOVERIES.md
# Controls: A/D move, Space jump twice, Shift dash, J weapon, Esc gear, R retry.
set -eu

emberwood_dir=$(CDPATH= cd -P "$(dirname "$0")" && pwd)
exec "$emberwood_dir/start-game.sh" "$@"
